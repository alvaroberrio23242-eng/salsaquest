# SalsaQuest - Variables de entorno requeridas
# Copia este archivo como .env y rellena los valores reales.
# NUNCA commitees el archivo .env con valores reales.

# Obligatoria: la app se niega a arrancar sin ella
SECRET_KEY=change_me_to_a_random_string

# API de Anthropic (para servicio de datos curiosos - aun no integrado)
ANTHROPIC_API_KEY=your_key_here

# Opcionales: credenciales para crear admin via init_db.py
# Si no estan configuradas, no se crea ningun administrador.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=
